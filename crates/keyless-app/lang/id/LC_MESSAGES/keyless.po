msgstr "Bahasa"

msgid "Settings"
msgstr "Pengaturan"

msgid "Startup, display, language and the paused tag."
msgstr "Mulai, tampilan, bahasa, dan penanda jeda."

msgid "STARTUP"
msgstr "MULAI"

msgid "Start at sign-in"
msgstr "Mulai saat masuk"

msgid "Always starts with keys on."
msgstr "Selalu mulai dengan keyboard aktif."

