msgid "NEVER"
msgstr "TIDAK PERNAH"

msgid "Your mouse always works. Locking the screen, signing out or sleep resumes the keyboard."
msgstr "Mouse selalu berfungsi. Mengunci layar, keluar, atau tidur akan melanjutkan keyboard."

msgid "Click your new shortcut"
msgstr "Klik pintasan baru Anda"

msgid "Shortcut"
msgstr "Pintasan"

msgid "Modifiers first, then one key."
msgstr "Tombol pengubah dulu, lalu satu tombol."

msgid "Press the new combination now."
msgstr "Tekan kombinasi baru sekarang."

msgid "Pauses and resumes from any app."
msgstr "Menjeda dan melanjutkan dari aplikasi apa pun."

msgid "Listening… press keys"
msgstr "Mendengarkan… tekan tombol"

msgid "Not set"
msgstr "Belum diatur"

msgid "Type it"
msgstr "Ketik"

msgid "Change shortcut by typing it"
msgstr "Ubah pintasan dengan mengetiknya"

