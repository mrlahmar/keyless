msgid "Rest anything on it. Your mouse still works."
msgstr "Кладите на неё что угодно. Мышь продолжает работать."

msgid "Flip the switch or press {}."
msgstr "Переключите тумблер или нажмите {}."

msgid "Flip the switch to pause."
msgstr "Переключите тумблер, чтобы поставить на паузу."

