msgstr "ВЕРСИЯ {} · ЛИЦЕНЗИЯ MIT"

msgid "PRIVACY"
msgstr "КОНФИДЕНЦИАЛЬНОСТЬ"

msgid "Keyless looks at each key only to decide whether to block it. Nothing is recorded, stored or sent. No network, no telemetry."
msgstr "Keyless проверяет каждую клавишу только для того, чтобы решить, блокировать ли её. Ничего не записывается, не сохраняется и не отправляется. Без сети и телеметрии."

msgid "GOOD TO KNOW"
msgstr "ПОЛЕЗНО ЗНАТЬ"

msgid "Control Alt Delete always works."
msgstr "Ctrl Alt Delete всегда работает."

msgid "always works."
msgstr "работает всегда."

msgid "On-screen keyboards and voice typing keep working while paused."
msgstr "Экранная клавиатура и голосовой ввод работают и на паузе."

msgid "Source code"
msgstr "Исходный код"

msgid "Report a problem"
msgstr "Сообщить о проблеме"

