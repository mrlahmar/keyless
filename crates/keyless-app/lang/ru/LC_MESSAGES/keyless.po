msgstr "Отменить изменение сочетания"

msgid "Save"
msgstr "Сохранить"

msgid "Save shortcut {}"
msgstr "Сохранить сочетание {}"

msgid "That combination can't be used. Use Ctrl, Alt, Shift or Win with a letter, number or F-key."
msgstr "Это сочетание нельзя использовать. Используйте Ctrl, Alt, Shift или Win с буквой, цифрой или клавишей F."

msgid "{} is used by another app. Choose a different shortcut."
msgstr "{} уже используется другим приложением. Выберите другое сочетание."

msgid "The shortcut could not be set."
msgstr "Не удалось задать сочетание."

msgid "Shortcut can resume"
msgstr "Сочетание возобновляет"

msgid "Off: resting hands can only pause, never resume. Resume with the mouse."
msgstr "Выключено: лежащие руки могут только поставить на паузу, но не возобновить. Возобновляйте мышью."

msgid "Appearance: {}"
