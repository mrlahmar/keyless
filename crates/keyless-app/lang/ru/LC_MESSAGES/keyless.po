msgid "Your mouse always works. Locking the screen, signing out or sleep resumes the keyboard."
msgstr "Мышь работает всегда. При блокировке экрана, выходе из системы или переходе в сон клавиатура возобновляется."

msgid "Click your new shortcut"
msgstr "Выберите новое сочетание"

msgid "Shortcut"
msgstr "Сочетание клавиш"

msgid "Modifiers first, then one key."
msgstr "Сначала модификаторы, затем одна клавиша."

msgid "Press the new combination now."
msgstr "Нажмите новое сочетание."

msgid "Pauses and resumes from any app."
msgstr "Ставит на паузу и возобновляет из любого приложения."

msgid "Listening… press keys"
msgstr "Ожидание… нажмите клавиши"

msgid "Not set"
msgstr "Не задано"

msgid "Type it"
msgstr "Ввести"

msgid "Change shortcut by typing it"
msgstr "Изменить сочетание, введя его"

msgid "Click keys"
msgstr "Выбрать мышью"

msgid "Change shortcut by clicking keys"
msgstr "Изменить сочетание, выбрав клавиши мышью"

msgid "Cancel"
msgstr "Отмена"

