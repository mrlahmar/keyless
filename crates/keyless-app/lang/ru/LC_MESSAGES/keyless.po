msgstr "Сбросить положение индикатора паузы"

msgid "Pick an edge, or drag the tag anywhere by its body. Keyless remembers where you leave it. Only its Resume button resumes."
msgstr "Выберите край или перетащите индикатор куда угодно. Keyless запомнит место. Возобновляет только его кнопка «Возобновить»."

msgid "Resume"
msgstr "Возобновить"

msgid "Pause to try it"
msgstr "Поставить на паузу"

msgid "Pause your keyboard. Keep your mouse."
msgstr "Клавиатура на паузе, мышь работает."

