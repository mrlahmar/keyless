msgid "Follows your system unless you pick one."
msgstr "जब तक आप न चुनें, सिस्टम के अनुसार रहती है।"

msgid "PAUSED TAG"
msgstr "रोक संकेतक"

msgid "Show while paused"
msgstr "रुके होने पर दिखाएँ"

