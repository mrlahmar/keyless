msgid "RIGHT"
msgstr "दाएँ"

msgid "Reset"
msgstr "रीसेट"

msgid "Reset the paused tag position"
msgstr "रोक संकेतक की जगह रीसेट करें"

msgid "Pick an edge, or drag the tag anywhere by its body. Keyless remembers where you leave it. Only its Resume button resumes."
msgstr "कोई किनारा चुनें, या संकेतक को कहीं भी खींचें। Keyless याद रखता है कि आपने उसे कहाँ छोड़ा। सिर्फ़ इसका “फिर शुरू करें” बटन ही कीबोर्ड फिर शुरू करता है।"

msgid "Resume"
msgstr "फिर शुरू करें"

msgid "Pause to try it"
msgstr "आज़माने के लिए रोकें"

msgid "Pause your keyboard. Keep your mouse."
msgstr "कीबोर्ड रोकें। माउस चालू रखें।"

msgid "VERSION {} · MIT LICENSE"
msgstr "संस्करण {} · MIT लाइसेंस"

msgid "PRIVACY"
msgstr "गोपनीयता"

msgid "Keyless looks at each key only to decide whether to block it. Nothing is recorded, stored or sent. No network, no telemetry."
msgstr "Keyless हर कुंजी को सिर्फ़ यह तय करने के लिए देखता है कि उसे रोकना है या नहीं। कुछ भी रिकॉर्ड, सहेजा या भेजा नहीं जाता। कोई नेटवर्क नहीं, कोई टेलीमेट्री नहीं।"

msgid "GOOD TO KNOW"
msgstr "जानने योग्य"

