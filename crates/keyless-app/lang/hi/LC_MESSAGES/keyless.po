msgstr "भाषा"

msgid "Settings"
msgstr "सेटिंग्स"

msgid "Startup, display, language and the paused tag."
msgstr "स्टार्टअप, डिस्प्ले, भाषा और रोक संकेतक।"

msgid "STARTUP"
msgstr "स्टार्टअप"

msgid "Start at sign-in"
msgstr "साइन इन पर शुरू करें"

msgid "Always starts with keys on."
msgstr "हमेशा कुंजियाँ चालू रखकर शुरू होता है।"

