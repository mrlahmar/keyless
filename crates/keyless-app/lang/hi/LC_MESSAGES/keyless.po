msgid "Same as Windows"
msgstr "Windows के अनुसार"

msgid "Keyboard paused"
msgstr "कीबोर्ड रुका हुआ है"

msgid "Keyboard on"
msgstr "कीबोर्ड चालू है"

msgid "Rest anything on it. Your mouse still works."
msgstr "इस पर कुछ भी रखें। आपका माउस काम करता रहेगा।"

msgid "Flip the switch or press {}."
msgstr "स्विच बदलें या {} दबाएँ।"

msgid "Flip the switch to pause."
msgstr "रोकने के लिए स्विच बदलें।"

msgid "AUTO-RESUME"
msgstr "अपने आप फिर शुरू"

msgid "BACK ON IN {}"
msgstr "{} में फिर चालू"

msgid "UNTIL YOU RESUME"
msgstr "जब तक आप फिर शुरू न करें"

msgid "NEVER"
msgstr "कभी नहीं"

msgid "Your mouse always works. Locking the screen, signing out or sleep resumes the keyboard."
msgstr "आपका माउस हमेशा काम करता है। स्क्रीन लॉक करने, साइन आउट करने या स्लीप पर कीबोर्ड फिर शुरू हो जाता है।"

msgid "Click your new shortcut"
msgstr "नया शॉर्टकट क्लिक करें"

msgid "Shortcut"
msgstr "शॉर्टकट"

msgid "Modifiers first, then one key."
msgstr "पहले मॉडिफ़ायर कुंजियाँ, फिर एक कुंजी।"

msgid "Press the new combination now."
msgstr "अब नया संयोजन दबाएँ।"

msgid "Pauses and resumes from any app."
msgstr "किसी भी ऐप से रोकता और फिर शुरू करता है।"

msgid "Listening… press keys"
msgstr "सुन रहा है… कुंजियाँ दबाएँ"

msgid "Not set"
msgstr "सेट नहीं"

msgid "Type it"
msgstr "टाइप करें"

msgid "Change shortcut by typing it"
msgstr "टाइप करके शॉर्टकट बदलें"

msgid "Click keys"
msgstr "कुंजियाँ क्लिक करें"

msgid "Change shortcut by clicking keys"
msgstr "कुंजियाँ क्लिक करके शॉर्टकट बदलें"

msgid "Cancel"
msgstr "रद्द करें"

msgid "Cancel shortcut change"
msgstr "शॉर्टकट बदलना रद्द करें"

msgid "Save"
msgstr "सहेजें"

msgid "Save shortcut {}"
msgstr "शॉर्टकट {} सहेजें"

msgid "That combination can't be used. Use Ctrl, Alt, Shift or Win with a letter, number or F-key."
msgstr "यह संयोजन इस्तेमाल नहीं हो सकता। Ctrl, Alt, Shift या Win के साथ कोई अक्षर, अंक या F-कुंजी इस्तेमाल करें।"

msgid "{} is used by another app. Choose a different shortcut."
msgstr "{} कोई दूसरा ऐप इस्तेमाल कर रहा है। कोई दूसरा शॉर्टकट चुनें।"

msgid "The shortcut could not be set."
msgstr "शॉर्टकट सेट नहीं हो सका।"

msgid "Shortcut can resume"
msgstr "शॉर्टकट से फिर शुरू हो सकता है"

msgid "Off: resting hands can only pause, never resume. Resume with the mouse."
msgstr "बंद होने पर: टिके हुए हाथ सिर्फ़ रोक सकते हैं, फिर शुरू नहीं कर सकते। माउस से फिर शुरू करें।"

msgid "Appearance: {}"
msgstr "रूप: {}"

msgid "Show the paused tag at the top"
msgstr "रोक संकेतक ऊपर दिखाएँ"

msgid "Show the paused tag at the bottom"
msgstr "रोक संकेतक नीचे दिखाएँ"

msgid "Show the paused tag on the left"
msgstr "रोक संकेतक बाईं ओर दिखाएँ"

msgid "Show the paused tag on the right"
msgstr "रोक संकेतक दाईं ओर दिखाएँ"

msgid "Language"
msgstr "भाषा"

msgid "Settings"
msgstr "सेटिंग्स"

msgid "Startup, display, language and the paused tag."
