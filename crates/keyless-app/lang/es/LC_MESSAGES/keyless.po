msgid "Your mouse always works. Locking the screen, signing out or sleep resumes the keyboard."
msgstr "El ratón siempre funciona. Al bloquear la pantalla, cerrar sesión o suspender, el teclado se reanuda."

msgid "Click your new shortcut"
msgstr "Haz clic en tu nuevo atajo"

msgid "Shortcut"
msgstr "Atajo"

msgid "Modifiers first, then one key."
msgstr "Primero los modificadores, luego una tecla."

msgid "Press the new combination now."
msgstr "Pulsa ahora la nueva combinación."

msgid "Pauses and resumes from any app."
msgstr "Pausa y reanuda desde cualquier aplicación."

