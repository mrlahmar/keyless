// Accessible controls in the instrument style. Each one works with the mouse, the
// keyboard (Tab, Space, Enter) and screen readers, and shows a focus ring only for
// keyboard navigation.

import { Theme } from "theme.slint";

component FocusRing inherits Rectangle {
    in property <bool> visible-ring;
    in property <length> radius: Theme.radius-small;
    border-radius: radius + 3px;
    border-width: visible-ring ? 2px : 0px;
    border-color: Theme.focus;
}

// A horizontal row that runs right to left in right-to-left languages. Use it instead of
// HorizontalLayout wherever the order of the children carries meaning.
export component Row inherits FlexboxLayout {
    flex-direction: Theme.rtl ? FlexboxLayoutDirection.row-reverse : FlexboxLayoutDirection.row;
    flex-wrap: FlexboxLayoutWrap.no-wrap;
    // Like HorizontalLayout: items share the free space by their horizontal-stretch.
    alignment: LayoutAlignment.stretch;
}

// Small outlined "BETA" mark shown next to the wordmark while the version is 0.x or a
// pre-release.
export component BetaTag inherits Rectangle {
    accessible-role: text;
    accessible-label: @tr("Beta version");
    border-width: 1px;
    border-color: Theme.line-strong;
    border-radius: Theme.radius-tag;
    width: label.preferred-width + 12px;
    height: label.preferred-height + 4px;
    label := Text {
        text: @tr("BETA");
        font-family: Theme.mono;
        font-size: Theme.label;
        font-weight: 700;
        letter-spacing: 1.1px * Theme.tracking;
        color: Theme.text-muted;
    }
}

// Activates on Space and Enter.
component Activator inherits FocusScope {
    callback activated;
    width: 0px;
    height: 0px;
    key-pressed(event) => {
        if (event.text == " " || event.text == Key.Return) {
            root.activated();
            return accept;
        }
        reject
    }
}

// 18 x 18 line icons.
export component Icon {
    in property <string> name;
    in property <brush> tint: Theme.text;
    in property <length> size: 18px;
    width: size;
    height: size;

    if name == "control": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: tint;
        stroke-width: 1.6px;
        fill: transparent;
        commands: "M7.5 1.5 h3 a2.5 2.5 0 0 1 2.5 2.5 v10 a2.5 2.5 0 0 1 -2.5 2.5 h-3 a2.5 2.5 0 0 1 -2.5 -2.5 v-10 a2.5 2.5 0 0 1 2.5 -2.5 z";
    }
    if name == "control": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 18;
        viewbox-height: 18;
        fill: tint;
        commands: "M8 9 h2 a1 1 0 0 1 1 1 v3 a1 1 0 0 1 -1 1 h-2 a1 1 0 0 1 -1 -1 v-3 a1 1 0 0 1 1 -1 z";
    }
    if name == "shortcut": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: tint;
        stroke-width: 1.6px;
        fill: transparent;
        commands: "M3.5 4.5 h11 a2 2 0 0 1 2 2 v5 a2 2 0 0 1 -2 2 h-11 a2 2 0 0 1 -2 -2 v-5 a2 2 0 0 1 2 -2 z M4.5 7.5 h1.2 M8.4 7.5 h1.2 M12.3 7.5 h1.2 M6 10.5 h6";
    }
    if name == "settings": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: tint;
        stroke-width: 1.6px;
        fill: transparent;
        commands: "M3 5 h12 M3 13 h12";
    }
    if name == "settings": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 18;
        viewbox-height: 18;
        fill: tint;
        commands: "M8.8 5 a1.8 1.8 0 1 1 -3.6 0 a1.8 1.8 0 1 1 3.6 0 z M12.8 13 a1.8 1.8 0 1 1 -3.6 0 a1.8 1.8 0 1 1 3.6 0 z";
    }
    if name == "about": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 18;
        viewbox-height: 18;
        stroke: tint;
        stroke-width: 1.6px;
        fill: transparent;
        commands: "M16 9 a7 7 0 1 1 -14 0 a7 7 0 1 1 14 0 z M9 8 v5";
    }
    if name == "about": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 18;
        viewbox-height: 18;
        fill: tint;
        commands: "M9.9 5.4 a0.9 0.9 0 1 1 -1.8 0 a0.9 0.9 0 1 1 1.8 0 z";
    }
    if name == "grip": Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        fill: tint;
        commands: "M6.3 4 a1.3 1.3 0 1 1 -2.6 0 a1.3 1.3 0 1 1 2.6 0 z M12.3 4 a1.3 1.3 0 1 1 -2.6 0 a1.3 1.3 0 1 1 2.6 0 z M6.3 8 a1.3 1.3 0 1 1 -2.6 0 a1.3 1.3 0 1 1 2.6 0 z M12.3 8 a1.3 1.3 0 1 1 -2.6 0 a1.3 1.3 0 1 1 2.6 0 z M6.3 12 a1.3 1.3 0 1 1 -2.6 0 a1.3 1.3 0 1 1 2.6 0 z M12.3 12 a1.3 1.3 0 1 1 -2.6 0 a1.3 1.3 0 1 1 2.6 0 z";
    }
}

// Small monospace caps label above a group: "AUTO-RESUME".
export component SectionLabel inherits Text {
    font-family: Theme.mono;
    font-size: Theme.label;
    font-weight: 700;
    letter-spacing: Theme.label-spacing * Theme.tracking;
    color: Theme.text-faint;
    horizontal-alignment: Theme.start-align;
}

// kind: "primary" (inverted), "outline", "subtle" or "signal" (orange, monospace caps).
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> kind: "outline";
    in property <bool> enabled: true;
    in property <string> accessible-name: text;
    in property <length> button-height: 36px;
    callback clicked;

    height: button-height;
    border-radius: Theme.radius-small;
    background: !enabled ? Theme.line
        : kind == "primary" ? (touch.pressed ? Theme.invert.darker(0.25) : touch.has-hover ? Theme.invert.darker(0.12) : Theme.invert)
        : kind == "signal" ? (touch.pressed ? Theme.signal.darker(0.2) : touch.has-hover ? Theme.signal.darker(0.08) : Theme.signal)
        : kind == "subtle" ? (touch.pressed ? Theme.line : touch.has-hover ? Theme.strip : transparent)
        : (touch.pressed ? Theme.strip : touch.has-hover ? Theme.window : Theme.raised);
    border-width: kind == "outline" ? 1px : 0px;
    border-color: Theme.line-strong;

    accessible-role: button;
    accessible-label: accessible-name;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: focus;

    focus := Activator {
        enabled: root.enabled;
        activated => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: kind == "signal" ? 12px : 14px;
        padding-right: kind == "signal" ? 12px : 14px;
        alignment: center;
        Text {
            horizontal-alignment: Theme.start-align;
            text: root.text;
            font-family: kind == "signal" ? Theme.mono : Theme.font;
            font-size: kind == "signal" ? Theme.small : 14px;
            font-weight: kind == "signal" ? 700 : 500;
            letter-spacing: (kind == "signal" ? 1.2px : 0px) * Theme.tracking;
            color: !enabled ? Theme.text-faint
                : kind == "primary" ? Theme.on-invert
                : kind == "signal" ? Theme.on-signal
                : Theme.text;
            vertical-alignment: center;
        }
    }

    FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        visible-ring: focus.has-focus;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Square button with only an icon.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> accessible-name;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: Theme.radius-small;
    background: touch.pressed ? Theme.line : touch.has-hover ? Theme.strip : transparent;
    accessible-role: button;
    accessible-label: accessible-name;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    focus := Activator {
        activated => { root.clicked(); }
    }
    Icon {
        name: root.icon;
        size: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        visible-ring: focus.has-focus;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component RockerHalf inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <color> lit;
    in property <color> lit-text;
    in property <length> font-size: 13px;
    border-radius: 10px;
    background: active ? lit : Theme.hardware-off;
    animate background { duration: 160ms; }
    // A darker lower lip makes the active half look pressed in.
    Rectangle {
        y: parent.height - 3px;
        height: 3px;
        x: 6px;
        width: parent.width - 12px;
        background: root.active ? #00000040 : transparent;
    }
    Text {
        text: root.label;
        font-family: Theme.mono;
        font-weight: 700;
        font-size: root.font-size;
        letter-spacing: 1.8px * Theme.tracking;
        color: root.active ? root.lit-text : Theme.hardware-off-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The main ON / PAUSE switch. Vertical in the window, horizontal in the tray panel.
export component Rocker inherits Rectangle {
    in property <bool> paused;
    in property <bool> horizontal;
    callback toggled;

    border-radius: horizontal ? 12px : 16px;
    background: Theme.hardware;
    accessible-role: switch;
    accessible-label: @tr("Pause keyboard");
    accessible-checkable: true;
    accessible-checked: paused;
    accessible-action-default => { root.toggled(); }
    forward-focus: focus;

    focus := Activator {
        activated => { root.toggled(); }
    }

    if !root.horizontal: VerticalLayout {
        padding: 8px;
        spacing: 6px;
        RockerHalf {
            label: @tr("ON");
            active: !root.paused;
            lit: Theme.go;
            lit-text: Theme.on-go;
        }
        RockerHalf {
            label: @tr("PAUSE");
            active: root.paused;
            lit: Theme.signal;
            lit-text: Theme.on-signal;
        }
    }
    if root.horizontal: Row {
        padding: 6px;
        spacing: 6px;
        RockerHalf {
            label: @tr("ON");
            active: !root.paused;
            lit: Theme.go;
            lit-text: Theme.on-go;
            font-size: 12px;
        }
        RockerHalf {
            label: @tr("PAUSE");
            active: root.paused;
            lit: Theme.signal;
            lit-text: Theme.on-signal;
            font-size: 12px;
        }
    }

    FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        radius: root.border-radius;
        visible-ring: focus.has-focus;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

// A small vertical hardware switch: knob up and orange when on.
export component SlideSwitch inherits Rectangle {
    in property <bool> checked;
    width: 22px;
    height: 38px;
    border-radius: 6px;
    background: Theme.hardware;
    Rectangle {
        x: 3px;
        y: root.checked ? 3px : parent.height - self.height - 3px;
        width: 16px;
        height: 16px;
        border-radius: 4px;
        background: root.checked ? Theme.signal : Theme.hardware-off-text;
        animate y { duration: 140ms; easing: ease-out; }
    }
}

// A setting with a title, a description and a switch. The whole row toggles.
export component ToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> checked;
    in property <bool> boxed;
    callback toggled(bool);

    border-radius: Theme.radius;
    background: boxed ? Theme.raised : transparent;
    border-width: boxed ? 1px : 0px;
    border-color: Theme.line;

    accessible-role: switch;
    accessible-label: title;
    accessible-description: description;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { root.toggled(!root.checked); }
    forward-focus: focus;

    focus := Activator {
        activated => { root.toggled(!root.checked); }
    }

    // A grid rather than a Row: wrapped text inside a flexbox row would size itself in a loop.
    GridLayout {
        padding: root.boxed ? 14px : 2px;
        spacing-horizontal: 14px;
        VerticalLayout {
            row: 0;
            col: Theme.rtl ? 1 : 0;
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                horizontal-alignment: Theme.start-align;
                text: root.title;
                font-size: Theme.body;
                font-weight: 500;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.description != "": Text {
                horizontal-alignment: Theme.start-align;
                text: root.description;
                font-size: Theme.caption;
                color: Theme.text-faint;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            row: 0;
            col: Theme.rtl ? 0 : 1;
            alignment: center;
            SlideSwitch { checked: root.checked; }
        }
    }

    FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        radius: Theme.radius;
        visible-ring: focus.has-focus;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

// Auto-resume slider: five detents on a line. `progress` (0 to 1) fills the line up to
// the selected detent while a countdown runs.
export component Detents {
    in property <[string]> labels;
    in property <[string]> spoken;
    in property <int> selected;
    in property <float> progress;
    callback picked(int);

    height: 60px;
    property <length> step: (self.width - 28px) / max(1, root.labels.length - 1);

    Rectangle {
        x: 14px;
        y: 13px;
        width: parent.width - 28px;
        height: 2px;
        background: Theme.line-strong;
    }
    Rectangle {
        y: 12px;
        height: 4px;
        border-radius: 2px;
        width: root.step * root.selected * root.progress;
        x: Theme.rtl ? parent.width - 14px - self.width : 14px;
        background: Theme.signal;
    }

    for label[i] in root.labels: Rectangle {
        x: root.step * (Theme.rtl ? root.labels.length - 1 - i : i) - 10px;
        y: 0px;
        width: 48px;
        height: 60px;

        accessible-role: button;
        accessible-label: @tr("Resume automatically: {}", root.spoken[i]);
        accessible-checkable: true;
        accessible-checked: i == root.selected;
        accessible-action-default => { root.picked(i); }
        forward-focus: detent-focus;

        detent-focus := Activator {
            activated => { root.picked(i); }
        }

        Rectangle {
            width: i == root.selected ? 28px : 18px;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: i == root.selected ? 0px : 5px;
            border-radius: self.width / 2;
            background: i == root.selected ? Theme.signal : Theme.window;
            border-width: 2px;
            border-color: Theme.text;
        }
        Text {
            y: 38px;
            width: parent.width;
            text: label;
            font-family: Theme.mono;
            font-size: Theme.small;
            font-weight: 700;
            color: i == root.selected ? Theme.text : Theme.text-faint;
            horizontal-alignment: center;
        }
        FocusRing {
            x: 6px;
            y: -4px;
            width: parent.width - 12px;
            height: parent.height;
            visible-ring: detent-focus.has-focus;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.picked(i); }
        }
    }
}

// The same choices as small chips, for the tray panel.
export component ChoiceChips {
    in property <[string]> labels;
    in property <[string]> spoken;
    in property <string> group-name;
    in property <int> selected;
    callback picked(int);

    Row {
        spacing: 4px;
        for label[i] in root.labels: Rectangle {
            height: 32px;
            horizontal-stretch: 1;
            border-radius: Theme.radius-small;
            background: i == root.selected ? Theme.signal : chip-touch.has-hover ? Theme.strip : transparent;
            border-width: 1px;
            border-color: i == root.selected ? Theme.text : Theme.line-strong;

            accessible-role: button;
            accessible-label: @tr("{}: {}", root.group-name, root.spoken[i]);
            accessible-checkable: true;
            accessible-checked: i == root.selected;
            accessible-action-default => { root.picked(i); }
            forward-focus: chip-focus;

            chip-focus := Activator {
                activated => { root.picked(i); }
            }
            Text {
                text: label;
                font-family: Theme.mono;
                font-size: Theme.label;
                font-weight: 700;
                color: i == root.selected ? Theme.on-signal : Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            FocusRing {
                x: -3px;
                y: -3px;
                width: parent.width + 6px;
                height: parent.height + 6px;
                visible-ring: chip-focus.has-focus;
            }
            chip-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(i); }
            }
        }
    }
}

// One key cap, used to show shortcuts: [Ctrl] [Alt] [K].
export component Keycap inherits Rectangle {
    in property <string> label;
    in property <bool> lit;
    height: 28px;
    min-width: max(28px, caption.preferred-width + 16px);
    border-radius: 6px;
    background: lit ? Theme.face-ink : Theme.keycap-edge;
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 4px;
        border-radius: 5px;
        background: root.lit ? Theme.signal : Theme.keycap;
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-bottom: 3px;
        caption := Text {
            text: root.label;
            font-family: Theme.mono;
            font-size: Theme.small;
            font-weight: 700;
            color: root.lit ? Theme.on-signal : Theme.keycap-text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A tab in the window's sidebar.
export component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> hint;
    in property <bool> selected;
    callback clicked;

    height: 52px;
    border-radius: 10px;
    background: selected ? Theme.invert : touch.has-hover ? Theme.strip : transparent;

    accessible-role: tab;
    accessible-label: label;
    accessible-description: hint;
    accessible-item-selectable: true;
    accessible-item-selected: selected;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;

    focus := Activator {
        activated => { root.clicked(); }
    }

    Row {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 12px;
        Icon {
            name: root.icon;
            tint: root.selected ? Theme.on-invert : Theme.text;
            cross-axis-self-alignment: center;
            horizontal-stretch: 0;
        }
        // Takes the spare width, so the icon stays next to the label in both directions.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                horizontal-alignment: Theme.start-align;
                text: root.label;
                font-size: Theme.body;
                font-weight: 500;
                color: root.selected ? Theme.on-invert : Theme.text;
            }
            Text {
                horizontal-alignment: Theme.start-align;
                text: root.hint;
                font-size: Theme.small;
                color: root.selected ? Theme.on-invert.transparentize(0.35) : Theme.text-faint;
                overflow: elide;
            }
        }
    }

    FocusRing {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        radius: 10px;
        visible-ring: focus.has-focus;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Page title with its one-line explanation next to it. When both don't fit on one line
// (long titles in some languages), the explanation moves under the title as a whole
// instead of breaking mid-sentence.
export component PageHeader {
    in property <string> title;
    in property <string> subtitle;
    Row {
        flex-wrap: FlexboxLayoutWrap.wrap;
        alignment: start;
        cross-axis-alignment: CrossAxisAlignment.end;
        spacing-horizontal: 12px;
        spacing-vertical: 2px;
        Text {
            text: root.title;
            font-size: Theme.heading;
            font-weight: 700;
            letter-spacing: -0.5px * Theme.tracking;
            color: Theme.text;
        }
        VerticalLayout {
            padding-bottom: 4px;
            Text {
                text: root.subtitle;
                font-size: 14px;
                color: Theme.text-faint;
                overflow: elide;
            }
        }
    }
}

// Flat strip for a short note.
export component Note inherits Rectangle {
    in property <string> text;
    background: Theme.strip;
    border-radius: 10px;
    GridLayout {
        padding: 12px;
        padding-left: 14px;
        spacing-horizontal: 10px;
        VerticalLayout {
            row: 0;
            col: Theme.rtl ? 1 : 0;
            alignment: center;
            Icon {
                name: "about";
                size: 16px;
                tint: Theme.text-muted;
            }
        }
        Text {
            row: 0;
            col: Theme.rtl ? 0 : 1;
            horizontal-alignment: Theme.start-align;
            text: root.text;
            font-size: Theme.caption;
            color: Theme.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
    }
}

export component Card inherits Rectangle {
    background: Theme.raised;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}
