// Keyless UI: the main window (Control, Shortcut, Mouse, Settings, About), the tray panel, the
// paused tag and the tray icon. State and actions are shared through the AppState
// global; Rust keeps every window in sync.

import { AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { BetaTag, Button, Card, ChoiceCard, ChoiceChips, Detents, Divider, Icon, IconButton, Keycap, NavItem, Note, PageHeader, Rocker, Row, SectionLabel, ToggleRow } from "controls.slint";
import { AppMark, Face } from "face.slint";
import { KeyCap, KeyboardView } from "keyboard.slint";
import { MouseBody, MouseView } from "mouse.slint";

export { KeyCap, Theme }

export global AppState {
    in-out property <bool> paused;
    // Shortcut, for display ("Ctrl + Alt + K") and per part, for the drawn keyboard.
    in-out property <string> shortcut-text: "Ctrl + Alt + K";
    in-out property <bool> sc-ctrl: true;
    in-out property <bool> sc-alt: true;
    in-out property <bool> sc-shift;
    in-out property <bool> sc-win;
    in-out property <string> sc-key: "K";
    in-out property <string> super-name: "Win";
    // The drawn keyboard's layout-dependent keys under the active keyboard layout.
    in-out property <[KeyCap]> key-caps;
    in-out property <bool> shortcut-available: true;
    in-out property <bool> recording;
    // 0 none, 1 the combination can't be used, 2 another app uses it, 3 other failure.
    in-out property <int> shortcut-error;
    // The shortcut named in error 2.
    in-out property <string> shortcut-error-name;
    in-out property <bool> shortcut-unlocks: true;
    // Mouse while paused: 0 keeps working, 1 clicks and scroll blocked, 2 cursor frozen too.
    in-out property <int> mouse-block;
    // Mouse pausing is in force: chosen, and a shortcut works to resume.
    in-out property <bool> mouse-blocks;
    in-out property <int> auto-resume-index;
    // "14:32" while an auto-resume countdown runs, otherwise empty.
    in-out property <string> countdown;
    // 0 to 1, how much of the auto-resume time has passed.
    in-out property <float> progress;
    in-out property <bool> show-indicator: true;
    // 0 top, 1 bottom, 2 left, 3 right. `indicator-custom`: the user dragged it.
    in-out property <int> indicator-edge;
    in-out property <bool> indicator-custom;
    in-out property <bool> start-at-login;
    in-out property <int> appearance-index;
    // 0 follows Windows, then the languages in Choices.languages.
    in-out property <int> language-index;
    in-out property <string> version;
    // Version is 0.x or a pre-release: show the BETA tag and "(beta)" in the title.
    in-out property <bool> beta;
    // Debug build: named "Keyless Dev" so it can't be mistaken for the installed app.
    in-out property <bool> dev;
    // Main window tab: 0 Control, 1 Shortcut, 2 Settings, 3 About, 4 Mouse (shown after
    // Shortcut; numbered last so the tray menu's page numbers stay the same).
    in-out property <int> page;
    // Open "Are you sure?" dialog in the main window: 0 none, 1 hide the paused tag while
    // the mouse pauses, 2 pause the mouse while the tag is hidden (to `confirm-mouse-block`).
    in-out property <int> confirm;
    in-out property <int> confirm-mouse-block;
    // The main window is open: its animations may run.
    in-out property <bool> window-open;

    callback toggle();
    callback resume();
    callback open-page(int);
    callback open-source();
    callback open-issues();
    callback open-licenses();
    callback quit();
    callback record-shortcut();
    callback cancel-recording();
    // "Ctrl+Alt+K", set by clicking keys on the drawn keyboard.
    callback save-shortcut(string);
    callback shortcut-unlocks-changed(bool);
    callback mouse-block-changed(int);
    callback auto-resume-changed(int);
    callback show-indicator-changed(bool);
    callback indicator-edge-changed(int);
    callback indicator-reset();
    // Dragging the paused tag: offset since the press, then the drop.
    callback drag-indicator(length, length);
    callback indicator-dropped();
    callback start-at-login-changed(bool);
    callback appearance-changed(int);
    callback language-changed(int);
}

global Choices {
    out property <[string]> auto-labels: [@tr("OFF"), "5", "15", "30", "60"];
    out property <[string]> auto-spoken: [@tr("never"), @tr("after 5 minutes"), @tr("after 15 minutes"), @tr("after 30 minutes"), @tr("after 60 minutes")];
    out property <[string]> auto-after: ["", @tr("AFTER 5 MIN"), @tr("AFTER 15 MIN"), @tr("AFTER 30 MIN"), @tr("AFTER 60 MIN")];
    // Each language in its own name; the order matches LANGUAGES in app.rs.
    out property <[string]> languages: [@tr("Same as Windows"), "English", "中文（简体）", "हिन्दी", "Español", "العربية", "Français", "বাংলা", "Português", "Русский", "Bahasa Indonesia"];
}

// ---------- Control ----------

component ControlPage inherits VerticalLayout {
    spacing: 24px;
    alignment: start;

    PageHeader {
        title: AppState.paused && AppState.mouse-blocks ? @tr("Both paused")
            : AppState.paused ? @tr("Keyboard paused") : @tr("Keyboard on");
        subtitle: AppState.paused && AppState.mouse-blocks ? @tr("Press {} to resume.", AppState.shortcut-text)
            : AppState.paused ? @tr("Rest anything on it. Your mouse still works.")
            : AppState.shortcut-available ? @tr("Flip the switch or press {}.", AppState.shortcut-text)
            : @tr("Flip the switch to pause.");
    }

    Row {
        spacing: 20px;
        height: 210px;
        Rocker {
            width: 112px;
            paused: AppState.paused;
            toggled => { AppState.toggle(); }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.inset;
            border-radius: Theme.radius-large;
            Face {
                width: 250px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                asleep: AppState.paused;
                alive: AppState.window-open;
            }
            // A quiet hint that the mouse pauses too: it sleeps along with the face.
            if AppState.mouse-blocks: Rectangle {
                width: 48px;
                height: 52px;
                x: Theme.rtl ? 16px : parent.width - self.width - 16px;
                y: parent.height - self.height - 14px;
                accessible-role: image;
                accessible-label: @tr("Mouse pauses too");
                MouseBody {
                    width: parent.width;
                    mode: AppState.paused ? AppState.mouse-block : 0;
                    details: false;
                }
            }
        }
    }

    VerticalLayout {
        spacing: 12px;
        Row {
            SectionLabel {
                text: @tr("AUTO-RESUME");
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                horizontal-alignment: Theme.start-align;
                text: AppState.paused
                    ? (AppState.countdown != "" ? @tr("BACK ON IN {}", AppState.countdown) : @tr("UNTIL YOU RESUME"))
                    : (AppState.auto-resume-index == 0 ? @tr("NEVER") : Choices.auto-after[AppState.auto-resume-index]);
                font-family: Theme.mono;
                font-size: 14px;
                font-weight: 700;
                color: AppState.paused ? Theme.signal-text : Theme.text-faint;
            }
        }
        Detents {
            labels: Choices.auto-labels;
            spoken: Choices.auto-spoken;
            selected: AppState.auto-resume-index;
            progress: AppState.paused ? AppState.progress : 0;
            picked(index) => { AppState.auto-resume-changed(index); }
        }
    }

    Note {
        text: AppState.mouse-blocks
            ? @tr("Only {} resumes while the mouse is paused. Locking the screen, signing out or sleep resumes both.", AppState.shortcut-text)
            : @tr("Your mouse always works. Locking the screen, signing out or sleep resumes the keyboard.");
    }
}

// ---------- Shortcut ----------

component ShortcutPage inherits VerticalLayout {
    spacing: 20px;
    alignment: start;

    // Setting a shortcut by clicking keys: the draft lives here until saved.
    property <bool> clicking;
    property <bool> d-ctrl;
    property <bool> d-alt;
    property <bool> d-shift;
    property <bool> d-win;
    property <string> d-key;
    property <bool> d-valid: (d-ctrl || d-alt || d-shift || d-win) && d-key != "";
    property <string> d-text: (d-ctrl ? "Ctrl + " : "") + (d-alt ? "Alt + " : "") + (d-shift ? "Shift + " : "")
        + (d-win ? AppState.super-name + " + " : "") + d-key;

    PageHeader {
        title: root.clicking ? @tr("Click your new shortcut") : @tr("Shortcut");
        subtitle: root.clicking ? @tr("Modifiers first, then one key.")
            : AppState.recording ? @tr("Press the new combination now.")
            : @tr("Pauses and resumes from any app.");
    }

    HorizontalLayout {
        alignment: start;
        KeyboardView {
            interactive: root.clicking;
            ctrl: root.clicking ? root.d-ctrl : AppState.shortcut-available && AppState.sc-ctrl;
            alt: root.clicking ? root.d-alt : AppState.shortcut-available && AppState.sc-alt;
            shift: root.clicking ? root.d-shift : AppState.shortcut-available && AppState.sc-shift;
            win: root.clicking ? root.d-win : AppState.shortcut-available && AppState.sc-win;
            key: root.clicking ? root.d-key : AppState.shortcut-available ? AppState.sc-key : "";
            caps: AppState.key-caps;
            key-clicked(label, kind) => {
                if (kind == 1) {
                    if (label == "Ctrl") { root.d-ctrl = !root.d-ctrl; }
                    if (label == "Alt") { root.d-alt = !root.d-alt; }
                    if (label == "Shift") { root.d-shift = !root.d-shift; }
                    if (label == "Win") { root.d-win = !root.d-win; }
                } else if (kind == 2) {
                    root.d-key = root.d-key == label ? "" : label;
                }
            }
        }
    }

    Rectangle {
        background: Theme.strip;
        border-radius: Theme.radius;
        Row {
            padding: 12px;
            padding-left: 16px;
            spacing: 10px;
            Text {
                horizontal-alignment: Theme.start-align;
                text: root.clicking ? (root.d-text != "" ? root.d-text : "—")
                    : AppState.recording ? @tr("Listening… press keys")
                    : AppState.shortcut-available ? AppState.shortcut-text : @tr("Not set");
                font-family: Theme.mono;
                font-size: 16px;
                font-weight: 700;
                color: AppState.recording ? Theme.signal-text : Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if !root.clicking && !AppState.recording: Button {
                text: @tr("Type it");
                accessible-name: @tr("Change shortcut by typing it");
                clicked => { AppState.record-shortcut(); }
            }
            if !root.clicking && !AppState.recording: Button {
                text: @tr("Click keys");
                kind: "primary";
                accessible-name: @tr("Change shortcut by clicking keys");
                clicked => {
                    root.d-ctrl = AppState.sc-ctrl;
                    root.d-alt = AppState.sc-alt;
                    root.d-shift = AppState.sc-shift;
                    root.d-win = AppState.sc-win;
                    root.d-key = AppState.sc-key;
                    root.clicking = true;
                }
            }
            if AppState.recording: Button {
                text: @tr("Cancel");
                accessible-name: @tr("Cancel shortcut change");
                clicked => { AppState.cancel-recording(); }
            }
            if root.clicking: Button {
                text: @tr("Cancel");
                clicked => { root.clicking = false; }
            }
            if root.clicking: Button {
                text: @tr("Save");
                kind: "primary";
                enabled: root.d-valid;
                accessible-name: @tr("Save shortcut {}", root.d-text);
                clicked => {
                    AppState.save-shortcut((root.d-ctrl ? "Ctrl+" : "") + (root.d-alt ? "Alt+" : "")
                        + (root.d-shift ? "Shift+" : "") + (root.d-win ? "Win+" : "") + root.d-key);
                    root.clicking = false;
                }
            }
        }
    }

    if AppState.shortcut-error != 0: Text {

        horizontal-alignment: Theme.start-align;
        text: AppState.shortcut-error == 1 ? @tr("That combination can't be used. Use Ctrl, Alt, Shift or Win with a letter, number or F-key.")
            : AppState.shortcut-error == 2 ? @tr("{} is used by another app. Choose a different shortcut.", AppState.shortcut-error-name)
            : @tr("The shortcut could not be set.");
        font-size: Theme.caption;
        color: Theme.signal-text;
        wrap: word-wrap;
    }

    ToggleRow {
        title: @tr("Shortcut can resume");
        description: AppState.mouse-blocks ? @tr("Always on while the mouse pauses too.")
            : @tr("Off: resting hands can only pause, never resume. Resume with the mouse.");
        checked: AppState.shortcut-unlocks || AppState.mouse-blocks;
        enabled: !AppState.mouse-blocks;
        toggled(value) => { AppState.shortcut-unlocks-changed(value); }
    }
}

// ---------- Mouse ----------

component MousePage inherits VerticalLayout {
    spacing: 20px;
    alignment: start;

    // Picks a mode, asking first when the paused tag is hidden.
    function pick(index: int) {
        if (index != 0 && AppState.mouse-block == 0 && !AppState.show-indicator) {
            AppState.confirm-mouse-block = index;
            AppState.confirm = 2;
        } else {
            AppState.mouse-block-changed(index);
        }
    }

    PageHeader {
        title: @tr("Mouse");
        subtitle: @tr("Pause it with the keyboard, so nothing gets clicked.");
    }

    Rectangle {
        height: 190px;
        background: Theme.inset;
        border-radius: Theme.radius-large;
        MouseView {
            width: 340px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            mode: AppState.mouse-block;
            alive: AppState.window-open;
        }
    }

    // The page is 619px wide: three cards and two gaps.
    GridLayout {
        spacing-horizontal: 10px;
        ChoiceCard {
            row: 0;
            col: Theme.rtl ? 2 : 0;
            width: 199px;
            title: @tr("Keeps working");
            description: @tr("Only the keyboard pauses.");
            selected: AppState.mouse-block == 0;
            clicked => { root.pick(0); }
        }
        ChoiceCard {
            row: 0;
            col: 1;
            width: 199px;
            title: @tr("Block clicks");
            description: @tr("Clicks and scrolling stop. The pointer still moves.");
            selected: AppState.mouse-block == 1;
            clicked => { root.pick(1); }
        }
        ChoiceCard {
            row: 0;
            col: Theme.rtl ? 0 : 2;
            width: 199px;
            title: @tr("Freeze it");
            description: @tr("Clicks, scrolling and the pointer stop.");
            selected: AppState.mouse-block == 2;
            clicked => { root.pick(2); }
        }
    }

    Rectangle {
        background: Theme.strip;
        border-radius: Theme.radius;
        Row {
            padding: 10px;
            padding-left: 16px;
            spacing: 12px;
            SectionLabel {
                text: @tr("RESUME WITH");
                vertical-alignment: center;
            }
            if AppState.shortcut-available: VerticalLayout {
                alignment: center;
                Keycap { label: AppState.shortcut-text; }
            }
            if !AppState.shortcut-available: Text {
                horizontal-alignment: Theme.start-align;
                text: @tr("No shortcut set");
                font-size: 14px;
                color: Theme.signal-text;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if !AppState.shortcut-available: Button {
                text: @tr("Set a shortcut");
                button-height: 32px;
                clicked => { AppState.page = 1; }
            }
            if AppState.shortcut-available && !AppState.paused: Button {
                text: @tr("Pause to try it");
                kind: "primary";
                button-height: 32px;
                clicked => { AppState.toggle(); }
            }
        }
    }

    Note {
        text: AppState.mouse-block == 0 ? @tr("Pick Block clicks or Freeze it to pause the mouse too. Only the shortcut resumes then, so it always resumes.")
            : !AppState.shortcut-available ? @tr("The mouse keeps working until a shortcut is set, because only the shortcut can resume it.")
            : @tr("Locking the screen, signing out or sleep resumes both. Ctrl + Alt + Delete always works.");
    }
}

// ---------- Settings ----------

component AppearanceTile inherits Rectangle {
    in property <string> label;
    in property <string> spoken;
    in property <bool> selected;
    // 0 half and half, 1 light, 2 dark.
    in property <int> swatch;
    callback clicked;

    height: 70px;
    horizontal-stretch: 1;
    border-radius: Theme.radius;
    border-width: 2px;
    border-color: selected ? Theme.text : Theme.line;
    background: touch.has-hover ? Theme.window : Theme.raised;

    accessible-role: button;
    accessible-label: @tr("Appearance: {}", spoken);
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        alignment: center;
        spacing: 6px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 20px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.face-ink;
                clip: true;
                background: root.swatch == 2 ? #121212 : #eff0f1;
                if root.swatch == 0: Rectangle {
                    x: parent.width / 2;
                    width: parent.width / 2;
                    background: #121212;
                }
            }
        }
        Text {
            text: root.label;
            font-family: Theme.mono;
            font-size: Theme.label;
            font-weight: 700;
            letter-spacing: 1.1px * Theme.tracking;
            color: Theme.text;
            horizontal-alignment: center;
        }
    }
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Theme.radius + 3px;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.focus;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A small screen with four slots for the paused tag. The chosen slot is orange.
component SpotPicker inherits Rectangle {
    in property <bool> enabled;
    width: 196px;
    height: 124px;
    border-radius: 10px;
    border-width: 2px;
    border-color: Theme.text;
    background: Theme.inset;
    opacity: enabled ? 1 : 0.4;

    // Taskbar
    Rectangle {
        y: parent.height - 11px;
        x: 2px;
        width: parent.width - 4px;
        height: 9px;
        background: Theme.text.transparentize(0.2);
    }

    for spot[i] in [
        { name: @tr("Show the paused tag at the top"), x: 72px, y: 10px },
        { name: @tr("Show the paused tag at the bottom"), x: 72px, y: 91px },
        { name: @tr("Show the paused tag on the left"), x: 8px, y: 50px },
        { name: @tr("Show the paused tag on the right"), x: 136px, y: 50px },
    ]: Rectangle {
        property <bool> chosen: !AppState.indicator-custom && AppState.indicator-edge == i;
        x: spot.x;
        y: spot.y;
        width: 52px;
        height: 14px;
        border-radius: 4px;
        border-width: 2px;
        border-color: self.chosen ? Theme.face-ink : Theme.line-strong;
        background: self.chosen ? Theme.signal : slot-touch.has-hover && root.enabled ? Theme.raised : transparent;

        accessible-role: button;
        accessible-label: spot.name;
        accessible-checkable: true;
        accessible-checked: self.chosen;
        accessible-action-default => { if (root.enabled) { AppState.indicator-edge-changed(i); } }
        forward-focus: slot-focus;
        slot-focus := FocusScope {
            width: 0px;
            height: 0px;
            enabled: root.enabled;
            key-pressed(event) => {
                if (event.text == " " || event.text == Key.Return) {
                    AppState.indicator-edge-changed(i);
                    return accept;
                }
                reject
            }
        }
        Rectangle {
            x: -4px;
            y: -4px;
            width: parent.width + 8px;
            height: parent.height + 8px;
            border-radius: 7px;
            border-width: slot-focus.has-focus ? 2px : 0px;
            border-color: Theme.focus;
        }
        slot-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { AppState.indicator-edge-changed(i); }
        }
    }
}

// Current language in a button; the list opens in a popup. With keyboard focus, the
// Up and Down arrows also change the language directly.
component LanguagePicker inherits Rectangle {
    property <int> count: Choices.languages.length;
    property <length> item-height: 34px;
    property <length> list-height: self.count * self.item-height + 12px;
    height: 40px;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.focus : Theme.line-strong;
    background: touch.has-hover ? Theme.window : Theme.raised;

    accessible-role: combobox;
    accessible-label: @tr("Language");
    accessible-value: Choices.languages[AppState.language-index];
    accessible-action-default => { popup.show(); }
    forward-focus: focus;

    focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                popup.show();
                return accept;
            }
            if (event.text == Key.UpArrow && AppState.language-index > 0) {
                AppState.language-changed(AppState.language-index - 1);
                return accept;
            }
            if (event.text == Key.DownArrow && AppState.language-index < root.count - 1) {
                AppState.language-changed(AppState.language-index + 1);
                return accept;
            }
            reject
        }
    }

    Row {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: Choices.languages[AppState.language-index];
            font-size: 14px;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            horizontal-alignment: Theme.start-align;
            overflow: elide;
        }
        Path {
            width: 12px;
            height: 12px;
            cross-axis-self-alignment: center;
            viewbox-width: 12;
            viewbox-height: 12;
            stroke: Theme.text-faint;
            stroke-width: 1.6px;
            fill: transparent;
            commands: "M2.5 4.5 L6 8 L9.5 4.5";
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    // Opens upward when there is no room below.
    popup := PopupWindow {
        x: 0px;
        y: root.absolute-position.y + root.height + 4px + root.list-height > 680px ? -root.list-height - 4px : root.height + 4px;
        width: root.width;
        height: root.list-height;
        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.line-strong;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 6px;
                for name[i] in Choices.languages: Rectangle {
                    height: root.item-height;
                    border-radius: 6px;
                    background: i == AppState.language-index ? Theme.invert : item-touch.has-hover ? Theme.strip : transparent;
                    accessible-role: list-item;
                    accessible-label: name;
                    accessible-item-selectable: true;
                    accessible-item-selected: i == AppState.language-index;
                    accessible-action-default => { AppState.language-changed(i); }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: name;
                        font-size: 14px;
                        color: i == AppState.language-index ? Theme.on-invert : Theme.text;
                        vertical-alignment: center;
                        horizontal-alignment: Theme.start-align;
                    }
                    item-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppState.language-changed(i); }
                    }
                }
            }
        }
    }
}

component SettingsPage inherits VerticalLayout {
    spacing: 24px;
    alignment: start;

    PageHeader {
        title: @tr("Settings");
        subtitle: @tr("Startup, display, language and the paused tag.");
    }

    GridLayout {
        spacing-horizontal: 18px;
        VerticalLayout {
            row: 0;
            col: Theme.rtl ? 1 : 0;
            spacing: 12px;
            horizontal-stretch: 1;
            SectionLabel { text: @tr("STARTUP"); }
            ToggleRow {
                boxed: true;
                title: @tr("Start at sign-in");
                description: @tr("Always starts with keys on.");
                checked: AppState.start-at-login;
                toggled(value) => { AppState.start-at-login-changed(value); }
            }
        }
        VerticalLayout {
            row: 0;
            col: Theme.rtl ? 0 : 1;
            spacing: 12px;
            horizontal-stretch: 1;
            SectionLabel { text: @tr("DISPLAY"); }
            Row {
                spacing: 8px;
                AppearanceTile {
                    label: @tr("AUTO");
                    spoken: @tr("follow Windows");
                    swatch: 0;
                    selected: AppState.appearance-index == 0;
                    clicked => { AppState.appearance-changed(0); }
                }
                AppearanceTile {
                    label: @tr("LIGHT");
                    spoken: @tr("light");
                    swatch: 1;
                    selected: AppState.appearance-index == 1;
                    clicked => { AppState.appearance-changed(1); }
                }
                AppearanceTile {
                    label: @tr("DARK");
                    spoken: @tr("dark");
                    swatch: 2;
                    selected: AppState.appearance-index == 2;
                    clicked => { AppState.appearance-changed(2); }
                }
            }
        }
    }

    VerticalLayout {
        spacing: 12px;
        SectionLabel { text: @tr("LANGUAGE"); }
        Card {
            GridLayout {
                padding: 14px;
                spacing-horizontal: 14px;
                VerticalLayout {
                    row: 0;
                    col: Theme.rtl ? 1 : 0;
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        horizontal-alignment: Theme.start-align;
                        text: @tr("Language");
                        font-size: Theme.body;
                        font-weight: 500;
                        color: Theme.text;
                    }
                    Text {
                        horizontal-alignment: Theme.start-align;
                        text: @tr("Follows Windows unless you pick one.");
                        font-size: Theme.caption;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                }
                LanguagePicker {
                    row: 0;
                    col: Theme.rtl ? 0 : 1;
                    width: 230px;
                }
            }
        }
    }

    VerticalLayout {
        spacing: 12px;
        SectionLabel { text: @tr("PAUSED TAG"); }
        Card {
            GridLayout {
                padding: 14px;
                spacing-horizontal: 18px;
                VerticalLayout {
                    row: 0;
                    col: Theme.rtl ? 1 : 0;
                    alignment: start;
                    SpotPicker { enabled: AppState.show-indicator; }
                }
                VerticalLayout {
                    row: 0;
                    col: Theme.rtl ? 0 : 1;
                    spacing: 10px;
                    horizontal-stretch: 1;
                    ToggleRow {
                        title: @tr("Show while paused");
                        description: @tr("Off: only the tray icon turns orange.");
                        checked: AppState.show-indicator;
                        toggled(value) => {
                            if (!value && AppState.mouse-blocks) {
                                AppState.confirm = 1;
                            } else {
                                AppState.show-indicator-changed(value);
                            }
                        }
                    }
                    Row {
                        spacing: 8px;
                        height: 28px;
                        Text {
                            horizontal-alignment: Theme.start-align;
                            text: AppState.indicator-custom ? @tr("CUSTOM SPOT")
                                : AppState.indicator-edge == 0 ? @tr("TOP")
                                : AppState.indicator-edge == 1 ? @tr("BOTTOM")
                                : AppState.indicator-edge == 2 ? @tr("LEFT") : @tr("RIGHT");
                            font-family: Theme.mono;
                            font-size: Theme.small;
                            font-weight: 700;
                            color: Theme.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if AppState.indicator-custom: Button {
                            text: @tr("Reset");
                            button-height: 28px;
                            accessible-name: @tr("Reset the paused tag position");
                            clicked => { AppState.indicator-reset(); }
                        }
                    }
                    Text {
                        horizontal-alignment: Theme.start-align;
                        text: AppState.mouse-blocks
                            ? @tr("Pick an edge, or drag the tag anywhere by its body. Keyless remembers where you leave it. While the mouse pauses, it shows the shortcut instead of a Resume button.")
                            : @tr("Pick an edge, or drag the tag anywhere by its body. Keyless remembers where you leave it. Only its Resume button resumes.");
                        font-size: Theme.caption;
                        color: Theme.text-faint;
                        wrap: word-wrap;
                    }
                    Row {
                        alignment: start;
                        Button {
                            text: AppState.paused ? @tr("Resume") : @tr("Pause to try it");
                            kind: "primary";
                            button-height: 32px;
                            clicked => { AppState.toggle(); }
                        }
                    }
                }
            }
        }
    }
}

// ---------- About ----------

component AboutPage inherits VerticalLayout {
    spacing: 22px;
    alignment: start;

    Row {
        spacing: 20px;
        AppMark {
            width: 96px;
            alive: AppState.window-open;
        }
        // Takes the spare width, so the mark stays at the start (the right in Arabic).
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;
            Row {
                spacing: 12px;
                Text {
                    text: "KEYLESS";
                    font-family: Theme.mono;
                    font-size: 22px;
                    font-weight: 700;
                    letter-spacing: 4px * Theme.tracking;
                    color: Theme.text;
                }
                if AppState.beta: VerticalLayout {
                    alignment: center;
                    BetaTag { }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                horizontal-alignment: Theme.start-align;
                text: @tr("Pause your keyboard. Keep your mouse.");
                font-size: Theme.body;
                color: Theme.text-muted;
            }
            Text {
                horizontal-alignment: Theme.start-align;
                text: @tr("VERSION {} · MIT LICENSE", AppState.version);
                font-family: Theme.mono;
                font-size: Theme.small;
                font-weight: 700;
                color: Theme.text-faint;
            }
        }
    }

    GridLayout {
        spacing-horizontal: 14px;
        Card {
            row: 0;
            col: Theme.rtl ? 1 : 0;
            width: 302px;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                alignment: start;
                SectionLabel { text: @tr("PRIVACY"); }
                Text {
                    horizontal-alignment: Theme.start-align;
                    text: @tr("Keyless looks at each key only to decide whether to block it. Nothing is recorded, stored or sent. No network, no telemetry.");
                    font-size: 14px;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }
        Card {
            row: 0;
            col: Theme.rtl ? 0 : 1;
            width: 302px;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                alignment: start;
                SectionLabel { text: @tr("GOOD TO KNOW"); }
                // Wraps: the words move under the keys when they don't fit beside them.
                Row {
                    flex-wrap: FlexboxLayoutWrap.wrap;
                    spacing-horizontal: 6px;
                    spacing-vertical: 8px;
                    alignment: start;
                    accessible-role: text;
                    accessible-label: @tr("Control Alt Delete always works.");
                    Keycap { label: "Ctrl"; }
                    Keycap { label: "Alt"; }
                    Keycap { label: "Delete"; }
                    Text {
                        horizontal-alignment: Theme.start-align;
                        text: @tr("always works.");
                        font-size: 14px;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }
                Text {
                    horizontal-alignment: Theme.start-align;
                    text: @tr("On-screen keyboards and voice typing keep working while paused.");
                    font-size: 14px;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
        }
    }

    Row {
        spacing: 10px;
        alignment: start;
        Button {
            text: @tr("Source code");
            kind: "primary";
            clicked => { AppState.open-source(); }
        }
        Button {
            text: @tr("Report a problem");
            clicked => { AppState.open-issues(); }
        }
        Button {
            text: @tr("Third-party licenses");
            clicked => { AppState.open-licenses(); }
        }
    }

    Divider { }

    // Slint's own credit, as its royalty-free license asks.
    Row {
        alignment: start;
        AboutSlint { width: 150px; }
    }
}

// ---------- Confirm ----------

// Asks before a setup with nothing on screen saying how to resume: the mouse paused and
// the paused tag hidden. The safe choice has focus; Esc picks it.
component ConfirmDialog inherits Rectangle {
    background: Theme.scrim;
    accessible-role: groupbox;
    accessible-label: card-title.text;

    function close() { AppState.confirm = 0; }

    init => { safe.focus(); }

    // Swallows clicks outside the card.
    TouchArea { }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                return accept;
            }
            reject
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px;
            height: card.preferred-height;
            background: Theme.raised;
            border-radius: Theme.radius-large;
            border-width: 1px;
            border-color: Theme.line-strong;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000050;

            card := VerticalLayout {
                padding: 22px;
                spacing: 12px;
                card-title := Text {
                    horizontal-alignment: Theme.start-align;
                    text: AppState.confirm == 1 ? @tr("Hide the paused tag?") : @tr("Pause the mouse with the tag hidden?");
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    horizontal-alignment: Theme.start-align;
                    text: @tr("Keyboard and mouse will both pause, and nothing on screen will say how to resume. Only {} resumes.", AppState.shortcut-text);
                    font-size: 14px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                Row {
                    padding-top: 6px;
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: AppState.confirm == 1 ? @tr("Hide it") : @tr("Pause the mouse");
                        clicked => {
                            if (AppState.confirm == 1) {
                                AppState.show-indicator-changed(false);
                            } else {
                                AppState.mouse-block-changed(AppState.confirm-mouse-block);
                            }
                            root.close();
                        }
                    }
                    safe := Button {
                        text: AppState.confirm == 1 ? @tr("Keep it") : @tr("Cancel");
                        kind: "primary";
                        clicked => { root.close(); }
                    }
                }
            }
        }
    }
}

// ---------- Windows ----------

export component MainWindow inherits Window {
    // "Keyless Dev" is a name, like "Keyless", and only ever seen in debug builds.
    title: AppState.dev ? "Keyless Dev" : AppState.beta ? @tr("Keyless (beta)") : "Keyless";
    width: 880px;
    height: 680px;
    background: Theme.window;
    default-font-family: Theme.font;

    VerticalLayout {
        Row {
            height: 52px;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 8px;
            Text {
                horizontal-alignment: Theme.start-align;
                text: "KEYLESS";
                font-family: Theme.mono;
                font-size: 14px;
                font-weight: 700;
                letter-spacing: 2.5px * Theme.tracking;
                color: Theme.text;
                vertical-alignment: center;
            }
            if AppState.beta: VerticalLayout {
                alignment: center;
                padding-left: 2px;
                padding-right: 2px;
                BetaTag { }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: AppState.paused ? Theme.signal : Theme.go;
                }
            }
            Text {
                horizontal-alignment: Theme.start-align;
                text: AppState.paused ? @tr("PAUSED") : @tr("ON");
                font-family: Theme.mono;
                font-size: Theme.small;
                font-weight: 700;
                letter-spacing: 1.4px * Theme.tracking;
                color: Theme.text;
                vertical-alignment: center;
            }
        }
        Divider { }
        GridLayout {
            vertical-stretch: 1;
            VerticalLayout {
                row: 0;
                col: Theme.rtl ? 2 : 0;
                width: 196px;
                padding-top: 18px;
                padding-bottom: 18px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 4px;
                NavItem {
                    icon: "control";
                    label: @tr("Control");
                    hint: @tr("Pause and resume");
                    selected: AppState.page == 0;
                    clicked => { AppState.page = 0; }
                }
                NavItem {
                    icon: "shortcut";
                    label: @tr("Shortcut");
                    hint: AppState.shortcut-available ? AppState.shortcut-text : @tr("Not set");
                    selected: AppState.page == 1;
                    clicked => { AppState.page = 1; }
                }
                NavItem {
                    icon: "mouse";
                    label: @tr("Mouse");
                    hint: AppState.mouse-block == 0 ? @tr("Lock both") : AppState.mouse-block == 1 ? @tr("Clicks paused") : @tr("Frozen while paused");
                    selected: AppState.page == 4;
                    clicked => { AppState.page = 4; }
                }
                NavItem {
                    icon: "settings";
                    label: @tr("Settings");
                    hint: @tr("Display, language");
                    selected: AppState.page == 2;
                    clicked => { AppState.page = 2; }
                }
                NavItem {
                    icon: "about";
                    label: @tr("About");
                    hint: @tr("Version, privacy");
                    selected: AppState.page == 3;
                    clicked => { AppState.page = 3; }
                }
                Rectangle { vertical-stretch: 1; }
                Row {
                    padding-left: 12px;
                    Text {
                        horizontal-alignment: Theme.start-align;
                        text: @tr("VERSION {}", AppState.version);
                        font-family: Theme.mono;
                        font-size: Theme.label;
                        font-weight: 700;
                        letter-spacing: 1.1px * Theme.tracking;
                        color: Theme.text-faint;
                    }
                }
            }
            Rectangle {
                row: 0;
                col: Theme.rtl ? 1 : 1;
                width: 1px;
                background: Theme.line;
            }
            VerticalLayout {
                row: 0;
                col: Theme.rtl ? 0 : 2;
                horizontal-stretch: 1;
                padding-top: 26px;
                padding-bottom: 26px;
                padding-left: 32px;
                padding-right: 32px;
                if AppState.page == 0: ControlPage { }
                if AppState.page == 1: ShortcutPage { }
                if AppState.page == 2: SettingsPage { }
                if AppState.page == 3: AboutPage { }
                if AppState.page == 4: MousePage { }
            }
        }
    }

    if AppState.confirm != 0: ConfirmDialog {
        width: root.width;
        height: root.height;
    }
}

// Opens from the tray icon. Closes on Esc or when it loses focus.
export component Panel inherits Window {
    callback dismiss();
    // Read from Rust to place the panel before it is shown.
    out property <length> content-height: layout.preferred-height;
    title: AppState.dev ? "Keyless Dev" : "Keyless";
    no-frame: true;
    always-on-top: true;
    width: 300px;
    height: content-height;
    background: Theme.window;
    default-font-family: Theme.font;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            reject
        }

        layout := VerticalLayout {
            padding: 14px;
            spacing: 14px;

            Row {
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Face {
                        width: 52px;
                        asleep: AppState.paused;
                        details: false;
                        weight: 1.8;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text {
                        horizontal-alignment: Theme.start-align;
                        text: AppState.paused && AppState.mouse-blocks ? @tr("Both paused")
                            : AppState.paused ? @tr("Keyboard paused") : @tr("Keyboard on");
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Text {
                        horizontal-alignment: Theme.start-align;
                        text: AppState.paused ? (AppState.countdown != "" ? @tr("Back on in {}", AppState.countdown) : @tr("Until you resume"))
                            : AppState.mouse-blocks ? @tr("Pauses keyboard and mouse") : @tr("Mouse always works");
                        font-size: Theme.small;
                        color: Theme.text-faint;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "settings";
                        accessible-name: @tr("Open Keyless");
                        clicked => { AppState.open-page(0); }
                    }
                }
            }

            Rocker {
                horizontal: true;
                height: 58px;
                paused: AppState.paused;
                toggled => { AppState.toggle(); }
            }

            VerticalLayout {
                spacing: 8px;
                SectionLabel {
                    text: @tr("AUTO-RESUME");
                    font-size: 10px;
                }
                ChoiceChips {
                    labels: Choices.auto-labels;
                    spoken: Choices.auto-spoken;
                    group-name: @tr("Resume automatically");
                    selected: AppState.auto-resume-index;
                    picked(index) => { AppState.auto-resume-changed(index); }
                }
            }

            Divider { }

            Row {
                spacing: 8px;
                Text {
                    horizontal-alignment: Theme.start-align;
                    text: AppState.shortcut-available ? AppState.shortcut-text : @tr("No shortcut");
                    font-family: Theme.mono;
                    font-size: Theme.small;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("Quit");
                    kind: "subtle";
                    button-height: 30px;
                    accessible-name: @tr("Quit Keyless");
                    clicked => { AppState.quit(); }
                }
            }
        }
    }
}

// Shown while paused. Never takes focus. Drag it by its body to move it; only its
// Resume button resumes, so a stray click does nothing. While the mouse is paused too, it
// shows the shortcut instead of the button.
export component Indicator inherits Window {
    // Read from Rust to place the tag: it grows with longer translations.
    out property <length> content-width: max(340px, content.preferred-width);
    title: @tr("Keyless: keyboard paused");
    no-frame: true;
    always-on-top: true;
    width: content-width;
    height: 44px;
    background: Theme.dark ? Theme.hardware : Theme.raised;
    default-font-family: Theme.font;

    drag := TouchArea {
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
        moved => {
            if (self.pressed) {
                AppState.drag-indicator(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                AppState.indicator-dropped();
            }
        }
    }

    content := Row {
        padding-left: 10px;
        padding-right: 7px;
        spacing: 10px;
        Icon {
            name: "grip";
            size: 16px;
            tint: Theme.dark ? #eff0f180 : Theme.text-faint;
            cross-axis-self-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Face {
                width: 34px;
                asleep: true;
                details: false;
                weight: 2;
                outline: Theme.dark ? #eff0f1 : Theme.face-ink;
            }
        }
        if AppState.mouse-blocks: VerticalLayout {
            alignment: center;
            MouseBody {
                width: 22px;
                mode: AppState.mouse-block;
                details: false;
                outline: Theme.dark ? #eff0f1 : Theme.face-ink;
            }
        }
        Text {
            horizontal-alignment: Theme.start-align;
            text: AppState.mouse-blocks ? @tr("BOTH ASLEEP") : @tr("KEYS ASLEEP");
            font-family: Theme.mono;
            font-size: Theme.small;
            font-weight: 700;
            letter-spacing: 1.7px * Theme.tracking;
            color: Theme.dark ? #eff0f1 : Theme.text;
            vertical-alignment: center;
        }
        Text {
            horizontal-alignment: Theme.start-align;
            text: AppState.countdown != "" ? @tr("BACK IN {}", AppState.countdown)
                : AppState.mouse-blocks ? "" : @tr("MOUSE AWAKE");
            font-family: Theme.mono;
            font-size: Theme.small;
            font-weight: 700;
            color: Theme.dark ? #a8abb0 : Theme.text-faint;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        // The mouse can't click while it is paused: show the way back instead.
        if AppState.mouse-blocks: VerticalLayout {
            alignment: center;
            padding-right: 3px;
            Keycap {
                lit: true;
                label: AppState.shortcut-text;
                accessible-role: text;
                accessible-label: @tr("Press {} to resume", AppState.shortcut-text);
            }
        }
        if !AppState.mouse-blocks: VerticalLayout {
            alignment: center;
            Button {
                kind: "signal";
                text: @tr("RESUME");
                button-height: 30px;
                accessible-name: @tr("Resume keyboard");
                clicked => { AppState.resume(); }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    in property <bool> paused;
    // The mouse pauses with the keyboard.
    in property <bool> mouse;
    in property <image> icon-on;
    in property <image> icon-paused;
    // Debug build: say "Keyless Dev" so it can't be mistaken for the installed app.
    in property <bool> dev;
    callback open-panel();
    callback toggle();
    callback open-page(int);
    callback quit();

    icon: paused ? icon-paused : icon-on;
    // The dev texts are only ever seen in debug builds, so they are not translated.
    tooltip: dev ? (paused && mouse ? "Keyless Dev: keyboard and mouse paused" : paused ? "Keyless Dev: keyboard paused" : "Keyless Dev: keyboard on")
        : paused && mouse ? @tr("Keyless: keyboard and mouse paused")
        : paused ? @tr("Keyless: keyboard paused") : @tr("Keyless: keyboard on");
    title: dev ? "Keyless Dev" : "Keyless";
    clicked => { open-panel(); }

    Menu {
        MenuItem {
            title: paused ? @tr("Resume keyboard") : @tr("Pause keyboard");
            activated => { root.toggle(); }
        }
        MenuItem {
            title: @tr("Open Keyless");
            activated => { root.open-page(0); }
        }
        MenuItem {
            title: @tr("Settings");
            activated => { root.open-page(2); }
        }
        MenuItem {
            title: @tr("About Keyless");
            activated => { root.open-page(3); }
        }
        MenuSeparator { }
        MenuItem {
            title: @tr("Quit Keyless");
            activated => { root.quit(); }
        }
    }
}
